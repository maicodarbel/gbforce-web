                  {
                      "parameters":  {
                                         "jsCode":  "// ===== CONFIGURACIÓN (edita solo aquí) =====\nconst PRECIO_CAJA = 650;                          // precio real por caja (MXN). El navegador NUNCA decide el monto.\nconst ENVIO_FIJO = 129; const ENVIO_GRATIS_DESDE = 3;                                  // envío fijo en MXN para menos de ENVIO_GRATIS_DESDE cajas (null bloquea el cobro)\nconst WEBHOOK_SECRET = \u0027PON_AQUI_TU_SECRETO\u0027;     // el MISMO secreto que en el flujo \"clip-pago\"\nconst N8N_BASE = \u0027https://n8n.guiahudumaliving.online\u0027;\n// ============================================\nconst b = $input.first().json.body || {};\nconst c = b.cliente || {};\nconst clean = (s, max) =\u003e String(s == null ? \u0027\u0027 : s).replace(/[\\u0000-\\u001f\u003c\u003e]/g, \u0027 \u0027).trim().slice(0, max);\nconst fail = (msg) =\u003e [{ json: { ok: false, error: msg } }];\n\nconst qty = Number(b.qty);\nif (!Number.isInteger(qty) || qty \u003c 1 || qty \u003e 12) return fail(\u0027cantidad_invalida\u0027);\nconst cli = {\n  nombre: clean(c.nombre, 80), telefono: String(c.telefono || \u0027\u0027).replace(/\\D/g, \u0027\u0027),\n  correo: clean(c.correo, 120), calle: clean(c.calle, 120), colonia: clean(c.colonia, 80),\n  cp: String(c.cp || \u0027\u0027).replace(/\\D/g, \u0027\u0027), ciudad: clean(c.ciudad, 80), estado: clean(c.estado, 40),\n  referencias: clean(c.referencias, 160)\n};\nif (cli.nombre.length \u003c 3) return fail(\u0027nombre\u0027);\nif (!/^\\d{10}$/.test(cli.telefono)) return fail(\u0027telefono\u0027);\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(cli.correo)) return fail(\u0027correo\u0027);\nif (cli.calle.length \u003c 4 || cli.colonia.length \u003c 2 || cli.ciudad.length \u003c 2 || !cli.estado) return fail(\u0027direccion\u0027);\nif (!/^\\d{5}$/.test(cli.cp)) return fail(\u0027cp\u0027);\nif (b.aviso_privacidad !== true) return fail(\u0027aviso\u0027);\n\nconst envio = qty >= ENVIO_GRATIS_DESDE ? 0 : ENVIO_FIJO;\nif (envio === null) return fail('envio_pendiente');\nconst monto = Math.round((qty * PRECIO_CAJA + envio) * 100) / 100;\nconst alfabeto = \u0027ABCDEFGHJKLMNPQRSTUVWXYZ23456789\u0027;\nlet id = \u0027GB-\u0027; for (let i = 0; i \u003c 6; i++) id += alfabeto[Math.floor(Math.random() * alfabeto.length)];\nconst tr = b.tracking || {};\nreturn [{ json: {\n  ok: true, pedido: id, qty, monto, cli,\n  descripcion: (\u0027GB FORCE - \u0027 + qty + (qty === 1 ? \u0027 caja\u0027 : \u0027 cajas\u0027) + \u0027 de 7 viales\u0027).slice(0, 250),\n  webhookUrl: N8N_BASE + \u0027/webhook/clip-pago?t=\u0027 + encodeURIComponent(WEBHOOK_SECRET),\n  atribucion: JSON.stringify(tr).slice(0, 4000),\n  promociones: b.promociones === true,\n  fbp: clean(b.fbp, 120), fbc: clean(b.fbc, 200), eventId: clean(b.event_id, 80),\n  creadoEn: new Date().toISOString()\n} }];"
                                     },
